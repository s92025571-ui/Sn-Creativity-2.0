# ==============================================================================
# SN CREATIVITY AI 2.0 — ENVIRONMENT & SECRETS CONFIGURATION
# ==============================================================================
# Never commit actual secret values to GitHub (.env is gitignored).
# In Google AI Studio, configure secrets securely via the Secrets panel.
# For production builds, set GEMINI_BACKEND_PROXY_URL to your HTTPS proxy instead
# of embedding an API key inside the client APK.

# GEMINI_API_KEY: Optional direct Gemini REST API key for local development / prototyping.
# Keep as placeholder if using a secure backend proxy or local fallback mode.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# GEMINI_BACKEND_PROXY_URL: Optional secure production backend endpoint (e.g. Cloud Run / Firebase Functions)
# that proxies Gemini requests without exposing API secrets inside the APK.
GEMINI_BACKEND_PROXY_URL=UNCONFIGURED_BACKEND_PROXY_URL
